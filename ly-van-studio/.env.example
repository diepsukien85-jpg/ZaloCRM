# --- Bắt buộc ---
DATABASE_URL=postgres://lyvan:lyvan@localhost:5432/lyvan_studio
# Chuỗi ngẫu nhiên >= 32 ký tự: dùng ký JWT phiên và mã hoá khoá API (AES-256-GCM)
APP_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# --- Tuỳ chọn ---
# Cho phép người lạ tự đăng ký tài khoản (đặt false khi triển khai nội bộ)
ALLOW_SIGNUP=true
# Thư mục lưu file upload (ảnh, video, âm thanh, tài liệu)
UPLOAD_DIR=./storage
MAX_UPLOAD_MB=25
# Khoá AI mặc định (có thể thay bằng khoá nhập trong Cài đặt -> AI Provider; khoá trong Cài đặt được mã hoá trong DB)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Bắt buộc dùng chế độ DEMO (không gọi API ngoài, nội dung gắn nhãn DEMO)
AI_DEMO_MODE=false
# Secret cho cron gọi /api/cron/tick (Vercel Cron / crontab)
CRON_SECRET=
